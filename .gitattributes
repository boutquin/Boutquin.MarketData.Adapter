###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# Exclude private files from git archive (used for public repo squash push)
###############################################################################
CLAUDE.md export-ignore
AGENTS.md export-ignore
CLAUDE.local.md export-ignore
.claude/ export-ignore
.claude/** export-ignore
specs/ export-ignore
specs/** export-ignore
_local/ export-ignore
_local/** export-ignore
hooks/ export-ignore
hooks/** export-ignore
review-accepted.yaml export-ignore

###############################################################################
# behavior for image files
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary\n\n# Arena run evidence: versioned and shared, but never in a `git archive`.
.code-arena/ export-ignore
.code-arena/** export-ignore

# This replay driver consumes preserved private review inventories.
scripts/replay-robustness-controls.py export-ignore

# Private prepublication verification is not part of the public source export.
.github/workflows/qualify-stable-private.yml export-ignore

.github/workflows/qualify-patch-private.yml export-ignore

# Preserve fingerprinted API bytes across Windows and Unix checkouts.
/src/*/PublicAPI.*.txt text eol=lf
/specs/verification/price-basis-2.1/mutations/*.patch -whitespace

.github/workflows/pricebasis-verification.yml export-ignore

# This private test exercises the export-ignored sealed kernel preparer.
scripts/tests/test_prepare_release_kernel.py export-ignore
